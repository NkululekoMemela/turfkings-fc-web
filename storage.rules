rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isReasonableSize() {
      return request.resource.size < 60 * 1024 * 1024;
    }

    // ---------------------------------------------------------
    // OFFICIAL CAMERA SESSION
    //
    // Camera credentials are issued by the FANM server and bound
    // to exactly one Official match.
    // ---------------------------------------------------------
    function isCameraSession() {
      return signedIn()
             && request.auth.token.get("cameraSession", false) == true
             && request.auth.token.get("dataScope", "") == "official";
    }

    function cameraCanAccessMatch(clubId, matchId) {
      return isCameraSession()
             && request.auth.token.clubId == clubId
             && request.auth.token.matchId == matchId;
    }

    function cameraCanAccessVenueMatch(venueId, matchId) {
      return isCameraSession()
             && request.auth.token.venueId == venueId
             && request.auth.token.matchId == matchId;
    }

    // ---------------------------------------------------------
    // LEGACY FANM VIDEO STORAGE
    //
    // Keep current browser/manual-upload compatibility temporarily.
    // Camera identities are explicitly excluded so they cannot avoid
    // the new club + match security boundary.
    // ---------------------------------------------------------
    match /video_highlights/{matchId}/raw/{source}/{fileName} {
      allow read: if signedIn();

      allow write:
        if signedIn()
           && !isCameraSession()
           && isVideo()
           && isReasonableSize();
    }

    match /video_highlights/{matchId}/{allPaths=**} {
      allow read: if signedIn();
    }

    // ---------------------------------------------------------
    // CLUB-SCOPED OFFICIAL CAMERA STORAGE
    //
    // The server-issued camera credential and Storage path must
    // agree on BOTH clubId and matchId.
    // ---------------------------------------------------------
    match /clubs/{clubId}/video_highlights/{matchId}/raw/{source}/{fileName} {
      allow read: if signedIn();

      // Camera identities remain locked to their server-authorized club + match.
      // Normal signed-in FANM users may upload manual highlights to club-scoped storage.
      allow create, update:
        if signedIn()
           && isVideo()
           && isReasonableSize()
           && (
             !isCameraSession()
             || cameraCanAccessMatch(clubId, matchId)
           );

      // Normal authenticated FANM users may remove disposable camera footage.
      // Camera-session identities remain constrained to their own club + match.
      allow delete:
        if signedIn()
           && (
             !isCameraSession()
             || cameraCanAccessMatch(clubId, matchId)
           );
    }

    match /clubs/{clubId}/video_highlights/{matchId}/{allPaths=**} {
      allow read: if signedIn();
    }

    match /leagueVenues/{venueId}/chatImages/{uid}/{imageName} {
      function canPostFormation() {
        let venue = firestore.get(/databases/(default)/documents/leagueVenues/$(venueId)).data;
        let staffPath = /databases/(default)/documents/leagueVenues/$(venueId)/staff/$(uid);
        let participantPath = /databases/(default)/documents/leagueVenues/$(venueId)/chatParticipants/$(uid);
        return venue.ownerUid == uid
          || (firestore.exists(staffPath) && firestore.get(staffPath).data.status == "active")
          || (firestore.exists(participantPath) && activeFormationClubMember(firestore.get(participantPath).data));
      }
      function activeFormationClubMember(participant) {
        let membership = firestore.get(/databases/(default)/documents/clubFieldMemberships/$(participant.clubId)).data;
        let member = firestore.get(/databases/(default)/documents/clubs/$(participant.clubId)/members/$(participant.memberId)).data;
        return membership.status == "active" && membership.venueId == venueId
          && member.status == "active"
          && (member.get("uid", "") == uid || (member.get("email", "") != "" && member.get("email", "") == request.auth.token.get("email", "")));
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.get("email_verified", false) == true
        && request.auth.token.get("cameraSession", false) == false
        && imageName.matches("[A-Za-z0-9_-]+[.]png")
        && request.resource.contentType == "image/png"
        && request.resource.size <= 1024 * 1024 && canPostFormation();
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid
        && request.auth.token.get("cameraSession", false) == false;
    }

    match /leagueVenues/{venueId}/video_highlights/{matchId}/raw/{source}/{fileName} {
      function fieldVideoWriter() {
        let venue = firestore.get(
          /databases/(default)/documents/leagueVenues/$(venueId)
        ).data;
        let staffPath =
          /databases/(default)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid);
        return signedIn()
          && !isCameraSession()
          && matchId.matches('^venue__' + venueId + '__.*')
          && (
            venue.ownerUid == request.auth.uid
            || (
              firestore.exists(staffPath)
              && firestore.get(staffPath).data.status == "active"
              && (
                firestore.get(staffPath).data.isAdministrator == true
                || firestore.get(staffPath).data.role == "referee"
              )
            )
          );
      }

      allow read: if signedIn();
      allow create, update: if isVideo()
        && isReasonableSize()
        && (
          cameraCanAccessVenueMatch(venueId, matchId)
          || fieldVideoWriter()
        );
      allow delete: if cameraCanAccessVenueMatch(venueId, matchId)
        || fieldVideoWriter();
    }

    // ---------------------------------------------------------
    // FIELD/VENUE BRANDING STORAGE
    //
    // Public read supports Field cards before sign-in.
    // Only the authenticated Field creator may upload branding.
    // ---------------------------------------------------------
    match /leagueVenues/{venueId}/branding/{fileName} {
      allow read: if true;

      allow create, update:
        if signedIn()
           && !isCameraSession()
           && request.resource.contentType.matches('image/.*')
           && request.resource.size < 5 * 1024 * 1024
           && (
             firestore.get(
               /databases/(default)/documents/leagueVenues/$(venueId)
             ).data.ownerUid == request.auth.uid
             ||
             firestore.get(
               /databases/(default)/documents/leagueVenues/$(venueId)
             ).data.createdByUid == request.auth.uid
           );
    }

  }
}
