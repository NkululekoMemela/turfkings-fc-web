<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="4dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/fanm_goal_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/fanm_goal_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="11sp"/>
    </LinearLayout>
    <ImageView android:id="@+id/fanm_goal_crest" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginHorizontal="4dp" android:scaleType="fitCenter" android:visibility="gone"/>
    <TextView android:id="@id/fanm_score_close" android:layout_width="32dp" android:layout_height="match_parent"
        android:gravity="center" android:text="×" android:textSize="22sp" android:contentDescription="Hide this match score"/>
</LinearLayout>
