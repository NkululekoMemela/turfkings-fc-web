rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /facebookPublicationLocks/{document=**} { allow read, write: if false; }
    match /facebookHighlightQueue/{document=**} { allow read, write: if false; }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------
    // OFFICIAL CAMERA SESSION
    //
    // A redeemed FANM camera credential is bound to exactly one
    // Official club + match by server-issued custom-token claims.
    // ---------------------------------------------------------
    function isCameraSession() {
      return isSignedIn()
             && request.auth.token.get("cameraSession", false) == true
             && request.auth.token.get("dataScope", "") == "official";
    }

    function cameraCanAccessMatch(clubId, matchId) {
      return isCameraSession()
             && request.auth.token.get("clubId", "") == clubId
             && request.auth.token.get("matchId", "") == matchId;
    }

    function cameraCanAccessVenueMatch(venueId, matchId) {
      return isCameraSession()
             && request.auth.token.get("venueId", "") == venueId
             && request.auth.token.get("matchId", "") == matchId;
    }

    // ---------------------------------------------------------
    // OFFICIAL CLUB DATA
    //
    // Preserve existing temporary bootstrap behaviour for normal
    // FANM users. Camera identities are deliberately excluded here
    // so they cannot inherit unrestricted Official-club writes.
    // ---------------------------------------------------------
    function clubRootPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId);
    }

    function clubAdministrator(clubId) {
      let clubPath = clubRootPath(clubId);
      return isSignedIn()
        && !isCameraSession()
        && exists(clubPath)
        && (
          get(clubPath).data.get("ownerUid", "") == request.auth.uid
          || get(clubPath).data.get("createdByUid", "") == request.auth.uid
          || request.auth.uid in get(clubPath).data.get("adminUids", [])
          || (
            request.auth.token.get("email_verified", false) == true
            && request.auth.token.get("email", "") != ""
            && request.auth.token.email in
              get(clubPath).data.get("adminEmails", [])
          )
        );
    }

    match /clubs/{clubId} {
      allow read: if true;

      allow create: if isSignedIn()
        && !isCameraSession()
        && !request.resource.data.keys().hasAny(["organizationArchive", "deleted", "deletedAt", "deletedByUid", "deletedByEmail"])
        && request.resource.data.get("status", "") != "deleted"
        && request.resource.data.get("clubType", "community") == "community"
        && !request.resource.data.keys().hasAny(["companyId", "billingModel", "companyStatus", "ownerType", "ownerCompanyId"])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.auth.uid in request.resource.data.adminUids;

      allow update: if isSignedIn()
        && !isCameraSession()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["deleted", "deletedAt", "deletedByUid", "deletedByEmail", "organizationArchive"])
        && request.resource.data.get("status", "") != "deleted"
        && resource.data.get("status", "") != "deleted"
        && resource.data.get("deleted", false) != true
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["clubType", "companyId", "billingModel", "companyStatus", "ownerType", "ownerCompanyId"])
        && request.resource.data.get("ownerUid", "") ==
          resource.data.get("ownerUid", "")
        && request.resource.data.get("createdByUid", "") ==
          resource.data.get("createdByUid", "")
        && (
          clubAdministrator(clubId)
          || !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny([
              "id", "clubId", "name", "ownerUid", "ownerEmail",
              "createdByUid", "createdByEmail", "createdBy",
              "adminUids", "adminEmails", "adminNames",
              "captain", "captainEmail", "captainEmails",
              "status", "deleted", "deletedAt", "deletedByUid",
              "deletedByEmail", "bookingSettings", "paymentSettings", "homeColor", "awayColor", "currency"
            ])
        );

      allow delete: if false;
    }

    match /clubs/{clubId}/members/{memberId} {
      function ownMembership() {
        return isSignedIn()
          && !isCameraSession()
          && request.auth.token.get("email_verified", false) == true
          && request.auth.token.get("email", "") != ""
          && (
            resource.data.get("uid", "") == request.auth.uid
            || (resource.data.get("uid", "") == ""
              && resource.data.get("email", "") == request.auth.token.email)
          );
      }

      allow read: if ownMembership() || clubAdministrator(clubId);

      allow create: if request.resource.data.get("jerseyNumber", null) == null && (clubAdministrator(clubId)
        || (
          isSignedIn()
          && !isCameraSession()
          && request.auth.token.get("email_verified", false) == true
          && request.resource.data.get("email", "") ==
            request.auth.token.get("email", "")
          && request.resource.data.get("uid", request.auth.uid) ==
            request.auth.uid
          && request.resource.data.get("status", "") == "pending"
          && request.resource.data.get("role", "") == "player"
        ));

      allow update: if request.resource.data.get("jerseyNumber", null) == resource.data.get("jerseyNumber", null) && (clubAdministrator(clubId)
        || (
          ownMembership()
          && request.resource.data.get("ownsNumberedBib", false) is bool
          && request.resource.data.get("bibColor", "") is string
          && request.resource.data.get("bibColor", "").size() <= 40
          && request.resource.data.get("profileNameAliases", []) is list
          && request.resource.data.get("profileNameAliases", []).size() <= 20
          && (
            request.resource.data.get("playerId", "") == resource.data.get("playerId", "")
            || (
              resource.data.get("playerId", "") == ""
              && request.resource.data.get("playerId", "") is string
              && request.resource.data.playerId.size() > 0
              && request.resource.data.playerId.size() <= 150
              && getAfter(
                /databases/$(database)/documents/clubs/$(clubId)/players/$(request.resource.data.playerId)
              ).data.get("sourceMemberId", "") == memberId
            )
          )
          && (
            request.resource.data.get("jerseyNumber", null) == null
            || (
              request.resource.data.get("jerseyNumber", null) is int
              && request.resource.data.jerseyNumber >= 0
              && request.resource.data.jerseyNumber <= 999
            )
          )
          && (
            request.resource.data.get("uid", "") ==
              resource.data.get("uid", "")
            || (
              resource.data.get("uid", "") == ""
              && request.resource.data.get("uid", "") ==
                request.auth.uid
            )
          )
          && request.resource.data.get("role", "") ==
            resource.data.get("role", "")
          && request.resource.data.get("email", "") ==
            request.auth.token.get("email", "")
          && (
            (
              request.resource.data.get("status", "") ==
                resource.data.get("status", "")
              && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  "fullName", "shortName", "email",
                  "whatsappNumber", "phoneNumber",
                  "photoData", "photoUrl", "jerseyNumber", "playerId",
                  "ownsNumberedBib", "bibColor", "profileNameAliases", "profileUpdatedAt",
                  "profileUpdatedByUid", "profileUpdatedByRole",
                  "updatedAt"
                ])
            )
            || (
              resource.data.get("uid", "") == ""
              && request.resource.data.get("uid", "") ==
                request.auth.uid
              && request.resource.data.get("status", "") ==
                resource.data.get("status", "")
              && request.resource.data.get(
                "platformIdentityUid", ""
              ) in [
                request.auth.uid,
                resource.data.get("platformIdentityUid", "")
              ]
              && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  "email", "uid", "platformIdentityUid",
                  "updatedAt"
                ])
            )
            || (
              resource.data.get("status", "") == "withdrawn"
              && request.resource.data.get("status", "") == "pending"
              && request.resource.data.get("role", "") == "player"
              && request.resource.data.get(
                "platformIdentityUid", request.auth.uid
              ) == request.auth.uid
            )
          )
        ));

      allow delete: if clubAdministrator(clubId);
    }

    // Preserve the legacy access of unrelated Club subcollections.
    // The root and members are governed by the rules above.
    // Private source records and public football projections are separate documents.
    function ownsClubMember(clubId, memberId) {
      let path = /databases/$(database)/documents/clubs/$(clubId)/members/$(memberId);
      return isSignedIn() && !isCameraSession()
        && request.auth.token.get("email_verified", false) == true
        && exists(path)
        && (get(path).data.get("uid", "") == request.auth.uid
          || (get(path).data.get("uid", "") == ""
            && get(path).data.get("email", "") == request.auth.token.get("email", "!")));
    }
    function clubCaptain(clubId) {
      let club = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      return isSignedIn() && !isCameraSession()
        && request.auth.token.get("email_verified", false) == true
        && request.auth.token.get("email", "!") in club.get("captainEmails", [])
        || (isSignedIn() && !isCameraSession()
          && request.auth.token.get("email_verified", false) == true
          && request.auth.token.get("email", "!") == club.get("captainEmail", ""));
    }
    function ownsPrivatePlayer(clubId, data) {
      return ownsClubMember(clubId, data.get("sourceMemberId", "!"))
        || (isSignedIn() && !isCameraSession()
          && request.auth.token.get("email_verified", false) == true
          && data.get("platformIdentityUid", "") == request.auth.uid);
    }
    match /clubs/{clubId}/players/{playerId} {
      allow read: if clubAdministrator(clubId) || ownsPrivatePlayer(clubId, resource.data);
      allow create: if request.resource.data.get("jerseyNumber", null) == null && (clubAdministrator(clubId)
        || (ownsPrivatePlayer(clubId, request.resource.data)
          && request.resource.data.get("email", "") == request.auth.token.get("email", "!")
          && request.resource.data.get("roles", {}).get("admin", false) == false
          && request.resource.data.get("roles", {}).get("captain", false) == false));
      allow update: if request.resource.data.get("jerseyNumber", null) == resource.data.get("jerseyNumber", null) && (clubAdministrator(clubId)
        || (clubCaptain(clubId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["roles", "mentality", "shooting", "updatedAt"])
          && request.resource.data.get("roles", {}).get("admin", false) == resource.data.get("roles", {}).get("admin", false))
        || (ownsPrivatePlayer(clubId, resource.data)
          && ownsPrivatePlayer(clubId, request.resource.data)
          && request.resource.data.get("sourceMemberId", "") == resource.data.get("sourceMemberId", "")
          && request.resource.data.get("roles", {}) == resource.data.get("roles", {})
          && request.resource.data.get("email", "") == request.auth.token.get("email", "!")));
      allow delete: if clubAdministrator(clubId);
    }
    match /clubs/{clubId}/playerPhotos/{photoId} {
      allow read: if clubAdministrator(clubId) || ownsPrivatePlayer(clubId, resource.data);
      allow create, update: if clubAdministrator(clubId)
        || (ownsPrivatePlayer(clubId, request.resource.data)
          && request.resource.data.get("email", "") == request.auth.token.get("email", "!"));
      allow delete: if clubAdministrator(clubId);
    }
    match /clubs/{clubId}/humanMembers/{memberId} {
      allow read, write: if clubAdministrator(clubId) || ownsClubMember(clubId, memberId);
    }
    match /clubs/{clubId}/{publicKind}/{id} {
      allow read: if publicKind in ["publicMembers", "publicPlayers", "publicPlayerPhotos", "publicPendingSignups", "publicMatchSignups"];
      allow write: if false;
    }
    function ownsSignup(clubId, data) {
      let payer = data.get("payerUserId", data.get("userId", "!"));
      let playerPath = /databases/$(database)/documents/clubs/$(clubId)/players/$(payer);
      return isSignedIn() && !isCameraSession()
        && request.auth.token.get("email_verified", false) == true
        && (data.get("profileOwnerUid", "") == request.auth.uid
          || payer == request.auth.uid
          || (exists(playerPath) && ownsPrivatePlayer(clubId, get(playerPath).data)));
    }
    match /clubs/{clubId}/{signupKind}/{signupId} {
      allow get: if signupKind in ["pendingSignups", "matchSignups"]
        && (clubAdministrator(clubId) || ownsSignup(clubId,resource.data)
          || (isSignedIn() && !isCameraSession()
            && request.auth.token.get("email_verified", false) == true
            && !exists(/databases/$(database)/documents/clubs/$(clubId)/$(signupKind)/$(signupId))));
      allow list: if signupKind in ["pendingSignups", "matchSignups"] && clubAdministrator(clubId);
      // Server transactions handle capacity and keep contact fields out of public views.
      allow create: if signupKind in ["pendingSignups", "matchSignups"]
        && (clubAdministrator(clubId) || (isSignedIn() && !isCameraSession()
          && request.auth.token.get("email_verified", false) == true
          && request.resource.data.get("profileOwnerUid", "") == request.auth.uid));
      allow update: if signupKind in ["pendingSignups", "matchSignups"]
        && (clubAdministrator(clubId) || (ownsSignup(clubId,resource.data)
          && request.resource.data.get("payerUserId", "") == resource.data.get("payerUserId", "")
          && request.resource.data.get("profileOwnerUid", "") in [resource.data.get("profileOwnerUid", ""),request.auth.uid]));
      allow delete: if signupKind in ["pendingSignups", "matchSignups"] && clubAdministrator(clubId);
    }
    match /matchNumberSheets/{sheetId} {
      allow read: if true;
      allow write: if false;
    }
    match /playerPrivacyMigrations/{id} {
      allow read, write: if false;
    }
    match /clubDataAccess/{document=**} { allow read, write: if false; }
    function clubDataParticipant(clubId) {
      let pointer=/databases/$(database)/documents/clubDataAccess/$(clubId)/users/$(request.auth.uid);
      let memberId=exists(pointer)?get(pointer).data.get("memberId", "__none__"):"__none__";
      let member=/databases/$(database)/documents/clubs/$(clubId)/members/$(memberId);
      return exists(pointer) && exists(member)
        && get(member).data.get("status", "") == "active"
        && ownsClubMember(clubId,memberId);
    }
    function clubStateOperator(clubId) {
      let pointer=/databases/$(database)/documents/clubStateOperators/$(clubId)/users/$(request.auth.uid);
      let memberId=exists(pointer)?get(pointer).data.get("memberId", "__none__"):"__none__";
      let member=/databases/$(database)/documents/clubs/$(clubId)/members/$(memberId);
      return clubAdministrator(clubId) || (exists(pointer) && exists(member)
        && get(member).data.get("status", "") == "active"
        && get(member).data.get("role", "") in ["admin","captain"]
        && ownsClubMember(clubId,memberId));
    }
    match /clubs/{clubId}/playerDebuts/{id} {
      allow read: if isSignedIn() && (clubStateOperator(clubId) || clubDataParticipant(clubId));
      allow write: if false;
    }
    match /playerDebutMigrations/{id} { allow read, write: if false; }

    match /clubs/{clubId}/state/{stateId} {
      allow read: if true;
      allow write: if isSignedIn() && !isCameraSession()
        && request.auth.token.get("email_verified", false) == true
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.get("deleted", false) != true
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.get("status", "") != "deleted"
        && clubStateOperator(clubId);
    }
    match /clubStateOperators/{document=**} { allow read, write: if false; }

    match /clubs/{clubId}/{collectionName}/{document=**} {
      allow read: if !(collectionName in ["members", "players", "playerPhotos", "humanMembers", "pendingSignups", "matchSignups", "numberReservations", "numberOffers", "numberQuotes", "playerDebuts"]);
      allow write: if isSignedIn() && !isCameraSession()
        && request.auth.token.get("email_verified", false) == true
        && (clubStateOperator(clubId) || clubDataParticipant(clubId))
        && !(collectionName in ["state", "members", "players", "playerPhotos", "humanMembers", "pendingSignups", "matchSignups",
          "publicMembers", "publicPlayers", "publicPlayerPhotos", "publicPendingSignups", "publicMatchSignups", "numberReservations", "numberOffers", "numberQuotes", "playerDebuts"]);
    }

    // ---------------------------------------------------------
    // LEAGUE VENUES
    // Separate from club identities and club permissions.
    // ---------------------------------------------------------
    // Lost property is accessible only through verified server operations.
    match /fieldLostFoundItems/{document=**} {
      allow read, write: if false;
    }
    match /fieldLostFoundClaims/{document=**} {
      allow read, write: if false;
    }

    match /leagueSeasonSquads/{squadId} {
      // Access is through authenticated server operations.
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /leagueClubBookings/{bookingId} {
      function validBooking() {
        let data = request.resource.data;
        let venue = get(
          /databases/$(database)/documents/leagueVenues/$(data.venueId)
        ).data;
        let season = venue.league.activeSeason;
        let membership = get(
          /databases/$(database)/documents/clubFieldMemberships/$(data.clubId)
        ).data;
        let di = data.matchDayIndex;
        let fi = data.fixtureIndex;
        let minimum = season.gameFormat == "11_V_11" ? 11 :
          (season.gameFormat == "7_V_7" ? 7 :
          (season.gameFormat == "6_V_6" ? 6 : 5));
        return data.keys().hasOnly([
            "venueId", "seasonId", "matchDayId", "clubId",
            "matchDayIndex", "fixtureId", "fixtureIndex",
            "limit", "entries", "changedPlayerId", "updatedByUid", "updatedAt"
          ])
          && bookingId == data.venueId + "~" + data.seasonId
            + "~" + data.matchDayId + "~" + data.clubId
          && membership.status == "active" && membership.venueId == data.venueId
          && season.id == data.seasonId && season.status == "active"
          && season.get("schedulePublishedAtMs", 0) > 0
          && data.clubId in season.clubIds
          && di is int && fi is int && di >= 0 && fi >= 0
          && di < season.matchDays.size() && fi < season.fixtures.size()
          && season.matchDays[di].id == data.matchDayId
          && season.matchDays[di].status == "scheduled"
          && season.fixtures[fi].id == data.fixtureId
          && season.fixtures[fi].matchDayId == data.matchDayId
          && data.fixtureId in season.matchDays[di].fixtureIds
          && data.clubId in [
            season.fixtures[fi].clubAId, season.fixtures[fi].clubBId
          ]
          && season.fixtures[fi].status == "scheduled"
          && !(data.fixtureId in season.get("liveMatches", {}))
          && data.limit is int && data.limit >= minimum
          && data.limit <= season.get("maxPlayersPerClubPerDay", 30)
          && data.entries is map && data.entries.size() <= data.limit
          && data.updatedByUid == request.auth.uid
          && data.updatedAt == request.time;
      }

      function ownPendingChange() {
        let next = request.resource.data;
        let old = resource.data;
        let changed = next.entries.diff(old.entries).affectedKeys();
        let key = next.get("changedPlayerId", "");
        let removed = !(key in next.entries);
        let entry = removed ? old.entries.get(key, {}) : next.entries.get(key, {});
        let member = get(
          /databases/$(database)/documents/clubs/$(old.clubId)/members/$(entry.actorMemberId)
        ).data;
        let profilePath =
          /databases/$(database)/documents/clubs/$(old.clubId)/players/$(entry.sourcePlayerId);
        return next.diff(old).affectedKeys().hasOnly([
            "entries", "changedPlayerId", "updatedByUid", "updatedAt"
          ])
          && changed.size() == 1 && changed.hasOnly([key])
          && entry.playerId == key
          && entry.bookedByUid == request.auth.uid
          && entry.paymentStatus == "pending"
          && member.status == "active"
          && (
            member.get("uid", "") == request.auth.uid
            || (
              request.auth.token.get("email_verified", false)
              && request.auth.token.get("email", "") != ""
              && member.get("email", "") == request.auth.token.email
            )
          )
          && (
            removed
            || (
              !(key in old.entries)
              && entry.keys().hasOnly([
                "playerId", "sourcePlayerId", "fullName", "paymentStatus",
                "bookedByUid", "actorMemberId", "bookedAt"
              ])
              && entry.bookedAt == request.time
              && entry.fullName is string && entry.fullName.size() > 0
              && exists(profilePath)
              && get(profilePath).data.get("status", "active") == "active"
            )
          );
      }

      allow read: if isSignedIn() && !isCameraSession();
      allow create: if isSignedIn() && !isCameraSession()
        && validBooking()
        && clubAdministrator(request.resource.data.clubId);
      allow update: if isSignedIn() && !isCameraSession()
        && validBooking()
        && request.resource.data.clubId == resource.data.clubId
        && (
          clubAdministrator(resource.data.clubId)
          || ownPendingChange()
        );
      allow delete: if false;
    }

    match /clubFieldMemberships/{clubId} {
      function validFieldMembership() {
        return request.resource.data.keys().hasOnly([
            "clubId", "venueId", "status", "previousVenueId",
            "joinedAt", "updatedAt", "changedByUid"
          ])
          && request.resource.data.clubId == clubId
          && request.resource.data.venueId is string
          && request.resource.data.venueId.size() > 0
          && exists(
            /databases/$(database)/documents/leagueVenues/$(request.resource.data.venueId)
          )
          && request.resource.data.status == "active"
          && request.resource.data.changedByUid == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if isSignedIn() && !isCameraSession();
      allow create: if clubAdministrator(clubId)
        && validFieldMembership()
        && request.resource.data.joinedAt == request.time
        && request.resource.data.previousVenueId == "";
      allow update: if clubAdministrator(clubId)
        && validFieldMembership()
        && request.resource.data.joinedAt == resource.data.joinedAt
        && request.resource.data.previousVenueId == (
          request.resource.data.venueId == resource.data.venueId
            ? resource.data.previousVenueId
            : resource.data.venueId
        );
      allow delete: if false;
    }

    match /leagueVenues/{venueId} {

      // Public teamsheet projection; only the server can submit or replace it.
      match /seasons/{seasonId}/fieldMatchDayManifests/{matchDayId}/clubs/{clubId} {
        allow read: if true;
        allow write: if false;
      }

      // Banking and team payments are accessed through the authenticated service.
      match /paymentConfig/{document=**} {
        allow read, write: if false;
      }
      match /bankingRequests/{document=**} {
        allow read, write: if false;
      }
      match /paymentAudit/{document=**} {
        allow read, write: if false;
      }
      match /paymentLocks/{document=**} {
        allow read, write: if false;
      }
      match /teamPayments/{document=**} {
        allow read, write: if false;
      }


      // Club consent applies only to this Club's pending season invitation.
      function clubSeasonMembershipIsActive(clubId) {
        let membership = get(
          /databases/$(database)/documents/clubFieldMemberships/$(clubId)
        ).data;
        return membership.status == "active"
          && membership.venueId == venueId;
      }

      function clubSeasonResponse() {
        let before = resource.data.league.activeSeason;
        let after = request.resource.data.league.activeSeason;
        let clubId = after.get("lastRespondingClubId", "");

        return isSignedIn() && !isCameraSession()
          && clubId is string
          && clubId.size() > 0
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["league", "updatedAt"])
          && request.resource.data.league.diff(resource.data.league)
            .affectedKeys().hasOnly(["activeSeason"])
          && after.diff(before).affectedKeys().hasOnly([
            "invitations", "clubIds", "lastRespondingClubId"
          ])
          && before.get("registrationOpen", false) == true
          && before.get("firstPlayAtMs", 0) == 0
          && before.get("results", []).size() == 0
          && before.get("matchDayHistory", []).size() == 0
          && (
            !("signupDeadlineAtMs" in before)
            || (
              before.signupDeadlineAtMs is int
              && request.time <= timestamp.value(before.signupDeadlineAtMs)
            )
          )
          && (
            !exists(
              /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(before.id)/matches/current
            )
            || get(
              /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(before.id)/matches/current
            ).data.get("confirmedLineupSnapshot", null) == null
          )
          && clubId in before.get("invitations", {})
          && clubId in after.get("invitations", {})
          && before.invitations[clubId].status == "pending"
          && after.invitations[clubId].status in ["accepted", "declined"]
          && after.invitations[clubId].confirmedByUid == request.auth.uid
          && after.invitations[clubId].confirmedAt == request.time
          && after.invitations[clubId]
            .diff(before.invitations[clubId]).affectedKeys().hasOnly([
              "status", "confirmedByUid", "confirmedAt"
            ])
          && after.invitations.diff(before.invitations)
            .affectedKeys().hasOnly([clubId])
          && (
            (after.invitations[clubId].status == "accepted"
              && !(clubId in before.clubIds)
              && after.clubIds == before.clubIds.concat([clubId]))
            || (after.invitations[clubId].status == "declined"
              && after.clubIds == before.clubIds)
          )
          && request.resource.data.updatedAt == request.time
          && clubSeasonMembershipIsActive(clubId)
          && clubAdministrator(clubId);
      }

      function venueAfterCreation() {
        return getAfter(
          /databases/$(database)/documents/leagueVenues/$(venueId)
        );
      }

      function fieldStaffHasPower(power) {
        let venuePath =
          /databases/$(database)/documents/leagueVenues/$(venueId);
        let staffPath =
          /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid);
        let permissionPath =
          /databases/$(database)/documents/leagueVenues/$(venueId)/staffPermissions/$(request.auth.uid);
        return isSignedIn() && !isCameraSession() && (
          get(venuePath).data.ownerUid == request.auth.uid
          || (
            exists(staffPath)
            && get(staffPath).data.status == "active"
            && exists(permissionPath)
            && get(permissionPath).data.get(power, false) == true
          )
        );
      }

      // Guarded official results are committed by the referee endpoint only.
      // This prevents a previous phone's queued Firestore write overwriting recovery.
      function guardedBoothResults() {
        let old = resource.data.get("league", {}).get("activeSeason", {});
        let next = request.resource.data.get("league", {}).get("activeSeason", {});
        let path = /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(old.get("id", "none"))/matches/current;
        let priorResults = old.get("results", []);
        let nextResults = next.get("results", []);
        return priorResults == nextResults || (
          (!exists(path) || get(path).data.get("boothVersion", 0) != 1
            || get(path).data.status != "live")
          && (nextResults.size() <= priorResults.size()
            || old.get("liveMatches", {}).get(
              nextResults[priorResults.size()].get("fixtureId", ""), {}
            ).get("liveDocumentId", "current") == "current")
        );
      }

      function fieldClosurePowersRespected() {
        let old = resource.data.get("league", {}).get("activeSeason", {});
        let next = request.resource.data.get("league", {}).get("activeSeason", {});
        return resource.data.ownerUid == request.auth.uid || (
          (
            old.get("id", "") == next.get("id", "")
            || fieldStaffHasPower("endSeason")
          )
          && (
            old.get("matchDayHistory", []) == next.get("matchDayHistory", [])
            || (
              old.get("id", "") == next.get("id", "")
                ? fieldStaffHasPower("endMatchDay")
                : fieldStaffHasPower("endSeason")
            )
          )
        );
      }

      function delegatedFieldClosure() {
        let old = resource.data.league.activeSeason;
        let next = request.resource.data.league.activeSeason;
        let archivePath =
          /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(old.id);
        return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["league", "updatedAt"])
          && request.resource.data.league.diff(resource.data.league)
            .affectedKeys().hasOnly(["activeSeason"])
          && (
            (
              fieldStaffHasPower("endMatchDay")
              && next.diff(old).affectedKeys()
                .hasOnly(["matchDayHistory", "updatedAtMs"])
              && next.matchDayHistory.size() == old.get("matchDayHistory", []).size() + 1
              && next.matchDayHistory[old.get("matchDayHistory", []).size()]
                .endedByUid == request.auth.uid
            )
            || (
              fieldStaffHasPower("endSeason")
              && next.id != old.id
              && next.previousSeasonId == old.id
              && next.status == "active"
              && existsAfter(archivePath)
              && getAfter(archivePath).data.endedByUid == request.auth.uid
              && getAfter(archivePath).data.status in ["completed", "cancelled"]
              && next.results.size() == 0
              && next.matchDayHistory.size() == 0
              && next.fixtures.size() == 0
              && next.clubIds.size() == 0
            )
          );
      }

      function activeFieldAdministrator() {
        return isSignedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            || (
              exists(
                /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid)
              )
              && get(
                /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid)
              ).data.status == "active"
              && get(
                /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid)
              ).data.isAdministrator == true
            )
          );
      }

      function activeFieldMatchOperator() {
        let staffPath =
          /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid);
        return isSignedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            || (
              exists(staffPath)
              && get(staffPath).data.status == "active"
              && (
                get(staffPath).data.get("role", "") in ["field_manager", "assistant_manager", "field_assistant", "other_staff", "referee"]
              )
            )
          );
      }

      function onlySelectsDatedFixture() {
        let old = resource.data.league.activeSeason;
        let next = request.resource.data.league.activeSeason;
        let fi = next.get("selectedFixtureIndex", -1);
        let di = next.get("selectedMatchDayIndex", -1);
        let livePath =
          /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(old.id)/matches/current;
        return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["league", "updatedAt"])
          && request.resource.data.league.diff(resource.data.league)
            .affectedKeys().hasOnly(["activeSeason"])
          && next.diff(old).affectedKeys().hasOnly([
            "selectedFixtureId", "selectedFixtureIndex", "selectedMatchDayIndex"
          ])
          && old.get("scheduleVersion", 0) == 1
          && fi is int && di is int && fi >= 0 && di >= 0
          && fi < old.fixtures.size() && di < old.matchDays.size()
          && di == old.get("matchDayHistory", []).size()
          && old.fixtures[fi].id == next.selectedFixtureId
          && old.fixtures[fi].status == "scheduled"
          && old.fixtures[fi].matchDayId == old.matchDays[di].id
          && next.selectedFixtureId in old.matchDays[di].fixtureIds
          && !(next.selectedFixtureId in old.get("liveMatches", {}))
          && (!exists(livePath) || get(livePath).data.status != "live");
      }

      function onlyUpdatesLiveMatches() {
        return request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(["league", "updatedAt"])
          && request.resource.data.league
            .diff(resource.data.league)
            .affectedKeys()
            .hasOnly(["activeSeason"])
          && request.resource.data.league.activeSeason
            .diff(resource.data.league.activeSeason)
            .affectedKeys()
            .hasOnly(["liveMatches"]);
      }

      function onlyCompletesCurrentFieldMatch() {
        let old = resource.data.league.activeSeason;
        let next = request.resource.data.league.activeSeason;
        let prior = old.get("results", []);
        let result = next.results[prior.size()];
        let fixtureId = result.fixtureId;
        let removed = old.fixtures.removeAll(next.fixtures);
        let added = next.fixtures.removeAll(old.fixtures);

        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["league", "updatedAt"])
          && request.resource.data.league.diff(resource.data.league)
            .affectedKeys().hasOnly(["activeSeason"])
          && next.diff(old).affectedKeys().hasOnly([
            "status", "fixtures", "liveMatches", "results",
            "allEvents", "currentMatchNo", "currentMatch",
            "streaks", "updatedAtMs"
          ])
          && next.id == old.id
          && next.status == "active"
          && next.results.size() == prior.size() + 1
          && next.results.hasAll(prior)
          && result.id == fixtureId
          && result.completedByUid == request.auth.uid
          && result.matchNo == old.get("currentMatchNo", prior.size() + 1)
          && next.currentMatchNo == result.matchNo + 1
          && old.liveMatches[fixtureId].status == "live"
          && old.liveMatches[fixtureId].get("liveDocumentId", "current") == "current"
          && result.teamAId == old.liveMatches[fixtureId].clubAId
          && result.teamBId == old.liveMatches[fixtureId].clubBId
          && result.standbyId == old.liveMatches[fixtureId].standbyId
          && result.standbyId in next.clubIds
          && next.streaks.diff(old.get("streaks", {}))
            .affectedKeys().hasOnly([
              result.teamAId, result.teamBId, result.standbyId
            ])
          && next.currentMatch.teamAId in next.clubIds
          && next.currentMatch.teamBId in next.clubIds
          && next.currentMatch.standbyId in next.clubIds
          && next.currentMatch.teamAId != next.currentMatch.teamBId
          && next.currentMatch.teamAId != next.currentMatch.standbyId
          && next.currentMatch.teamBId != next.currentMatch.standbyId
          && next.liveMatches.diff(old.liveMatches)
            .affectedKeys().hasOnly([fixtureId])
          && next.liveMatches[fixtureId].status == "completed"
          && next.liveMatches[fixtureId].completedByUid == request.auth.uid
          && next.liveMatches[fixtureId].scoreA == result.goalsA
          && next.liveMatches[fixtureId].scoreB == result.goalsB
          && next.fixtures.size() == old.fixtures.size()
          && removed.size() == 1
          && added.size() == 1
          && removed[0].id == fixtureId
          && removed[0].status == "scheduled"
          && added[0].id == fixtureId
          && added[0].status == "completed"
          && added[0].clubAId == removed[0].clubAId
          && added[0].clubBId == removed[0].clubBId
          && added[0].goalsA == result.goalsA
          && added[0].goalsB == result.goalsB
          && next.allEvents.hasAll(old.get("allEvents", []));
      }

      allow read: if true;

      allow create: if isSignedIn()
                    && !isCameraSession()
                    && request.resource.data.id == venueId
                    && !exists(/databases/$(database)/documents/deletedFieldIds/$(venueId))
                    && !request.resource.data.keys().hasAny(["organizationArchive", "deleted", "deletedAt", "deletedByUid", "deletedByEmail"])
        && request.resource.data.get("status", "") != "deleted"
        && request.resource.data.get("clubType", "community") == "community"
        && !request.resource.data.keys().hasAny(["companyId", "billingModel", "companyStatus", "ownerType", "ownerCompanyId"])
        && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.adminUids;

      allow update: if !isCameraSession()
                    && request.resource.data.ownerUid
                       == resource.data.ownerUid
                    && request.resource.data.id == venueId
                    && isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["deleted", "deletedAt", "deletedByUid", "deletedByEmail", "organizationArchive"])
        && request.resource.data.get("status", "") != "deleted"
        && resource.data.get("status", "") != "deleted"
        && resource.data.get("deleted", false) != true
                    && guardedBoothResults()
                    && fieldClosurePowersRespected()
                    && fieldTestingSettingProtected()
                    && (
                      activeFieldAdministrator()
                        ? true
                        : (
                          activeFieldMatchOperator()
                            ? (
                              (
                                 request.resource.data.league.activeSeason
                                   .diff(resource.data.league.activeSeason)
                                   .affectedKeys().hasAny(["results"])
                                 && onlyCompletesCurrentFieldMatch()
                               )
                               || onlyUpdatesLiveMatches()
                               || onlySelectsDatedFixture()
                               || delegatedFieldClosure()
                            )
                            : (delegatedFieldClosure() || clubSeasonResponse())
                        )
                    );

      allow delete: if false;

      function fieldTestingSettingProtected() {
        let oldValue = resource.data.get("league", {}).get("activeSeason", {});
        let newValue = request.resource.data.get("league", {}).get("activeSeason", {});
        let old = oldValue is map ? oldValue : {};
        let next = newValue is map ? newValue : {};
        return resource.data.ownerUid == request.auth.uid
          || (
            next.get("allowEarlyStarts", false) == old.get("allowEarlyStarts", false)
            && next.get("testingChangedByUid", null) == old.get("testingChangedByUid", null)
            && next.get("testingChangedAt", null) == old.get("testingChangedAt", null)
          );
      }

      function fieldRosterRevisionCurrent(approval, seasonId, clubId) {
        let squadPath =
          /databases/$(database)/documents/leagueSeasonSquads/$(venueId + "~" + seasonId + "~" + clubId);
        let squadVersions = approval.get("squadVersions", {});
        return clubId in squadVersions
          ? (
            get(squadPath).data.status == "active"
            && get(squadPath).data.updatedAt == squadVersions[clubId]
          )
          : (
            !exists(squadPath)
            && get(
              /databases/$(database)/documents/leagueClubBookings/$(venueId + "~" + seasonId + "~" + approval.matchDayId + "~" + clubId)
            ).data.updatedAt == approval.bookingVersions[clubId]
          );
      }

      function paidFieldStartApproved(seasonId) {
        let data = request.resource.data;
        let approvalPath =
          /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(seasonId)/startApprovals/$(data.get("startApprovalId", ""));
        let approval = get(approvalPath).data;
        let season = get(
          /databases/$(database)/documents/leagueVenues/$(venueId)
        ).data.league.activeSeason;
        let fixture = season.fixtures[data.fixtureIndex];
        return approval.actorUid == request.auth.uid
          && (
            approval.get("stockRevision", 0) > 0
            && exists(/databases/$(database)/documents/leagueVenues/$(venueId)/bibHireConfig/stock)
            && approval.stockRevision == get(/databases/$(database)/documents/leagueVenues/$(venueId)/bibHireConfig/stock).data.revision
          )
          && approval.venueId == venueId && approval.seasonId == seasonId
          && approval.fixtureId == data.fixtureId
          && data.get("paidSquads", {}) == approval.get("squads", {})
          && data.get("confirmedLineupSnapshot", {}) == approval.get("startingLineups", {})
          && approval.get("startingLineups", {}).size() == 2
          && approval.matchDayId == fixture.matchDayId
          && approval.clubAId == fixture.clubAId
          && approval.clubBId == fixture.clubBId
          && approval.gameFormat == season.gameFormat
          && data.get("gameFormat", season.gameFormat) == approval.gameFormat
          && approval.matchDayHistory == season.get("matchDayHistory", [])
          && approval.matchDays == season.get("matchDays", [])
          && approval.get("liveMatchesAtApproval", season.get("liveMatches", {}))
            == season.get("liveMatches", {})
          && approval.expiresAt > request.time
          && approval.used == false
          && getAfter(approvalPath).data.used == true
          && fieldRosterRevisionCurrent(approval, seasonId, approval.clubAId)
          && fieldRosterRevisionCurrent(approval, seasonId, approval.clubBId);
      }

      match /seasons/{seasonId}/matchDayReviews/{matchDayId} {
        allow read: if isSignedIn() && !isCameraSession();
        allow write: if false;
      }

      match /decisionRequests/{requestId} {
        allow read: if isSignedIn() && !isCameraSession()
          && (
            get(/databases/$(database)/documents/leagueVenues/$(venueId))
              .data.ownerUid == request.auth.uid
            || resource.data.requestedByUid == request.auth.uid
          );
        allow write: if false;
      }

      match /seasonDeletionJobs/{seasonId} {
        allow read: if isSignedIn() && !isCameraSession()
          && get(/databases/$(database)/documents/leagueVenues/$(venueId))
            .data.ownerUid == request.auth.uid;
        allow write: if false;
      }

      match /seasons/{seasonId}/startApprovals/{approvalId} {
        allow read: if isSignedIn()
          && resource.data.actorUid == request.auth.uid;
        allow create, delete: if false;
        allow update: if activeFieldOperatorForSeason(seasonId)
          && resource.data.actorUid == request.auth.uid
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["used"])
          && startApprovalHasMatch(seasonId, resource.data.fixtureId, approvalId);
      }

      function startApprovalHasMatch(seasonId, fixtureId, approvalId) {
        let venuePath = /databases/$(database)/documents/leagueVenues/$(venueId);
        let matchId = getAfter(venuePath).data.league.activeSeason.liveMatches[fixtureId]
          .get("liveDocumentId", "current");
        let matchPath = /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(seasonId)/matches/$(matchId);
        return (matchId == "current" || matchId == fixtureId)
          && getAfter(matchPath).data.fixtureId == fixtureId
          && getAfter(matchPath).data.startApprovalId == approvalId;
      }

      function newFieldFixtureDocument(seasonId, matchId) {
        let venuePath = /databases/$(database)/documents/leagueVenues/$(venueId);
        let before = get(venuePath).data.league.activeSeason.get("liveMatches", {});
        let after = getAfter(venuePath).data.league.activeSeason.liveMatches;
        let data = request.resource.data;
        return matchId == data.fixtureId
          && !(matchId in before)
          && after.diff(before).affectedKeys().hasOnly([matchId])
          && after[matchId].liveDocumentId == matchId
          && after[matchId].fixtureId == matchId
          && after[matchId].status == "live"
          && after[matchId].clubAId == data.teamAId
          && after[matchId].clubBId == data.teamBId
          && after[matchId].matchNo == data.currentMatchNo
          && after[matchId].startedByUid == request.auth.uid
          && data.startedByUid == request.auth.uid
          && data.liveMatchController.uid == request.auth.uid
          && data.teamAId == get(venuePath).data.league.activeSeason.fixtures[data.fixtureIndex].clubAId
          && data.teamBId == get(venuePath).data.league.activeSeason.fixtures[data.fixtureIndex].clubBId
          && get(/databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(seasonId)/startApprovals/$(data.startApprovalId))
            .data.get("liveMatchesAtApproval", null) == before;
      }

      function datedFieldMatchCanStart(seasonId) {
        let season = get(
          /databases/$(database)/documents/leagueVenues/$(venueId)
        ).data.league.activeSeason;
        let data = request.resource.data;
        let fi = data.get("fixtureIndex", -1);
        let di = data.get("matchDayIndex", -1);
        return season.id == seasonId && (
          season.get("scheduleVersion", 0) != 1
          || (
            fi is int && di is int && fi >= 0 && di >= 0
            && fi < season.get("fixtures", []).size()
            && di < season.get("matchDays", []).size()
            && season.fixtures[fi].id == data.fixtureId
            && season.fixtures[fi].status == "scheduled"
            && season.fixtures[fi].matchDayId == season.matchDays[di].id
            && data.fixtureId in season.matchDays[di].fixtureIds
            && season.matchDays[di].status == "scheduled"
            && season.matchDays[di].opensAtMs is int
            && (
              request.time.toMillis() >= season.matchDays[di].opensAtMs
              || get(/databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(seasonId)/startApprovals/$(data.get("startApprovalId", ""))).data.get("earlyStartConfirmed", false) == true
            )
          )
        );
      }

      function activeFieldOperatorForSeason(seasonId) {
        let venue = get(
          /databases/$(database)/documents/leagueVenues/$(venueId)
        ).data;
        let staffPath =
          /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid);

        return isSignedIn()
          && !isCameraSession()
          && venue.league.activeSeason.id == seasonId
          && (
            venue.ownerUid == request.auth.uid
            || (
              exists(staffPath)
              && get(staffPath).data.status == "active"
              && (
                get(staffPath).data.get("role", "") in ["field_manager", "assistant_manager", "field_assistant", "other_staff", "referee"]
              )
            )
          );
      }

      match /matchReversals/{reversalId} {
        allow read: if isSignedIn() && !isCameraSession() && get(/databases/$(database)/documents/leagueVenues/$(venueId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }
      match /actionLog/{entryId} {
        function venueDoc() {
          return get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data;
        }

        function activeStaff() {
          let staffPath =
            /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(request.auth.uid);
          return isSignedIn()
            && !isCameraSession()
            && (
              venueDoc().ownerUid == request.auth.uid
              || (
                exists(staffPath)
                && get(staffPath).data.status == "active"
              )
            );
        }

        allow read: if activeStaff();

        allow create: if activeStaff()
          && request.resource.data.keys().hasOnly([
            "venueId", "seasonId", "fixtureId", "action", "label",
            "details", "actorUid", "actorEmail", "actorName", "at"
          ])
          && request.resource.data.keys().hasAll([
            "venueId", "seasonId", "fixtureId", "action", "label",
            "details", "actorUid", "actorEmail", "actorName", "at"
          ])
          && request.resource.data.venueId == venueId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorEmail ==
            request.auth.token.get("email", "")
          && request.resource.data.at == request.time
          && request.resource.data.seasonId is string
          && request.resource.data.fixtureId is string
          && request.resource.data.action in [
            "season_created", "season_started", "match_started", "match_completed",
            "match_day_saved", "match_day_discarded", "season_ended", "season_cancelled",
            "empty_season_deleted", "fixture_pairing_selected", "match_reversed", "match_corrected", "staff_permissions_changed"
          ]
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 100
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 500
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 100;

        allow update, delete: if false;
      }

      match /seasons/{seasonId} {
        function validUnplayedSeasonCancellation() {
          let venuePath =
            /databases/$(database)/documents/leagueVenues/$(venueId);
          let season = get(venuePath).data.league.activeSeason;
          let archive = request.resource.data;
          return archive.status == "cancelled"
            && season.id == seasonId
            && season.status == "active"
            && season.get("results", []).size() == 0
            && season.get("matchDayHistory", []).size() == 0
            && season.get("allEvents", []).size() == 0
            && season.get("currentEvents", []).size() == 0
            && season.get("liveMatches", {}).keys().size() == 0
            && !exists(
              /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(seasonId)/matches/current
            )
            && archive.diff(season).affectedKeys().hasOnly([
              "status", "registrationOpen", "cancellationReason",
              "endedAtMs", "endedByUid"
            ])
            && archive.registrationOpen == false
            && archive.cancellationReason is string
            && archive.cancellationReason.size() >= 10
            && archive.cancellationReason.size() <= 500
            && archive.endedAtMs is int
            && getAfter(venuePath).data.league.activeSeason.id != seasonId
            && getAfter(venuePath).data.league.activeSeason.previousSeasonId == seasonId;
        }
        allow read: if true;
        allow create: if isSignedIn()
          && !isCameraSession()
          && fieldStaffHasPower("endSeason")
          && request.resource.data.id == seasonId
          && (
            request.resource.data.status == "completed"
            || validUnplayedSeasonCancellation()
          )
          && request.resource.data.endedByUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn()
          && !isCameraSession()
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.ownerUid == request.auth.uid
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.previousSeasonId == seasonId
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("clubIds", []).size() == 0
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("fixtures", []).size() == 0
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("results", []).size() == 0
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("allEvents", []).size() == 0
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("matchDayHistory", []).size() == 0
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("currentEvents", []).size() == 0
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("invitations", {}).keys().size() == 0
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.get("liveMatches", {}).keys().size() == 0
          && !exists(
            /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(get(
              /databases/$(database)/documents/leagueVenues/$(venueId)
            ).data.league.activeSeason.id)/matches/current
          )
          && getAfter(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.id == seasonId
          && getAfter(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.status == "active";
      }

      match /seasons/{seasonId}/matches/{matchId} {
        allow read: if true;

        allow create: if activeFieldOperatorForSeason(seasonId)
          && request.resource.data.venueId == venueId
          && request.resource.data.seasonId == seasonId
          && request.resource.data.status == "live"
          && datedFieldMatchCanStart(seasonId)
          && paidFieldStartApproved(seasonId)
          && (matchId == "current" || newFieldFixtureDocument(seasonId, matchId));

        allow update: if matchId == "current"
          && activeFieldOperatorForSeason(seasonId)
          && (resource.data.get("boothVersion", 0) != 1
            || (resource.data.status == "completed" && request.resource.data.status == "live"))
          && resource.data.venueId == venueId
          && resource.data.seasonId == seasonId
          && request.resource.data.venueId == venueId
          && request.resource.data.seasonId == seasonId
          && (
            (request.resource.data.fixtureId == resource.data.fixtureId
              && !(resource.data.status == "completed"
                && request.resource.data.status == "live")
              && request.resource.data.get("startApprovalId", "")
                == resource.data.get("startApprovalId", "")
              && request.resource.data.get("paidSquads", {})
                == resource.data.get("paidSquads", {})
              && request.resource.data.get("fixtureIndex", -1)
                == resource.data.get("fixtureIndex", -1)
              && request.resource.data.get("matchDayIndex", -1)
                == resource.data.get("matchDayIndex", -1))
            || (
              resource.data.status == "completed"
              && request.resource.data.status == "live"
              && request.resource.data.startedByUid == request.auth.uid
              && datedFieldMatchCanStart(seasonId)
              && paidFieldStartApproved(seasonId)
            )
          );

        allow delete: if matchId == "current"
          && activeFieldOperatorForSeason(seasonId)
          && !(resource.data.get("boothVersion", 0) == 1 && resource.data.status == "live");
      }

      match /seasons/{seasonId}/cameraRequests/{requestId} {
        function currentLiveMatch() {
          let fixtureId = request.method == "create" ? request.resource.data.fixtureId : resource.data.fixtureId;
          let season = get(/databases/$(database)/documents/leagueVenues/$(venueId)).data.league.activeSeason;
          let matchId = season.get("liveMatches", {}).get(fixtureId, {}).get("liveDocumentId", "current");
          return get(
            /databases/$(database)/documents/leagueVenues/$(venueId)/seasons/$(seasonId)/matches/$(matchId)
          ).data;
        }

        allow read: if isSignedIn()
          && !isCameraSession()
          && (
            activeFieldOperatorForSeason(seasonId)
            || resource.data.requestedByUid == request.auth.uid
          );

        allow create: if isSignedIn()
          && !isCameraSession()
          && requestId ==
            request.resource.data.fixtureId + "__" + request.auth.uid
          && request.resource.data.keys().hasOnly([
            "venueId", "seasonId", "fixtureId",
            "requestedByUid", "requesterName", "status", "requestedAtMs"
          ])
          && request.resource.data.venueId == venueId
          && request.resource.data.seasonId == seasonId
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.requesterName is string
          && request.resource.data.requesterName.size() <= 80
          && request.resource.data.status == "pending"
          && currentLiveMatch().status == "live"
          && currentLiveMatch().fixtureId ==
            request.resource.data.fixtureId;

        allow update: if (
          isSignedIn()
          && !isCameraSession()
          && resource.data.requestedByUid == request.auth.uid
          && resource.data.status != "pending"
          && currentLiveMatch().status == "live"
          && currentLiveMatch().fixtureId == resource.data.fixtureId
          && request.resource.data.keys().hasOnly([
            "venueId", "seasonId", "fixtureId",
            "requestedByUid", "requesterName", "status", "requestedAtMs"
          ])
          && request.resource.data.venueId == resource.data.venueId
          && request.resource.data.seasonId == resource.data.seasonId
          && request.resource.data.fixtureId == resource.data.fixtureId
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.requesterName is string
          && request.resource.data.requesterName.size() <= 80
          && request.resource.data.status == "pending"
          && request.resource.data.requestedAtMs > resource.data.requestedAtMs
        ) || (
          activeFieldOperatorForSeason(seasonId)
          && currentLiveMatch().status == "live"
          && currentLiveMatch().fixtureId == resource.data.fixtureId
          && currentLiveMatch().liveMatchController.uid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "status", "approvedByUid", "decidedAtMs"
            ])
          && request.resource.data.status in ["approved", "denied"]
          && request.resource.data.approvedByUid == request.auth.uid
        );

        allow delete: if false;
      }

      match /seasons/{seasonId}/goalkeeperRestrictions/{clubId} {
        allow read: if isSignedIn();

        allow create, update: if activeFieldOperatorForSeason(seasonId)
          && request.resource.data.clubId == clubId;

        allow delete: if false;
      }

      match /video_highlights/{matchId} {
        function fieldVideoWriter() {
          let seasonId = get(
            /databases/$(database)/documents/leagueVenues/$(venueId)
          ).data.league.activeSeason.id;
          return matchId.matches('^venue__' + venueId + '__.*')
            && activeFieldOperatorForSeason(seasonId);
        }

        allow read: if true;
        allow create, update, delete:
          if cameraCanAccessVenueMatch(venueId, matchId)
          || fieldVideoWriter();

        match /{document=**} {
          allow read: if true;
          allow create, update, delete:
            if cameraCanAccessVenueMatch(venueId, matchId)
            || fieldVideoWriter();
        }
      }

      match /newsStories/{storyId} {
        allow read: if true;
        allow create, update, delete: if activeFieldAdministrator();
      }

      match /newsPolls/{pollId} {
        allow read: if true;
        allow create, update, delete: if activeFieldAdministrator();
      }

      match /newsPollVotes/{voteId} {
        allow read: if true;
        allow create, update: if isSignedIn()
          && !isCameraSession()
          && request.resource.data.voterId == request.auth.uid
          && voteId == request.resource.data.pollId + "__" + request.auth.uid;
        allow delete: if isSignedIn() && !isCameraSession()
          && resource.data.voterId == request.auth.uid
          && voteId == resource.data.pollId + "__" + request.auth.uid;
      }

      // Field chat participation points to an existing Club member record.
      // The pointer itself confers no access unless that record and the
      // Field's current season still qualify on every request.
      function chatVenue() {
        return get(
          /databases/$(database)/documents/leagueVenues/$(venueId)
        ).data;
      }

      function chatStaffPath(uid) {
        return /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(uid);
      }

      function chatParticipantPath(uid) {
        return /databases/$(database)/documents/leagueVenues/$(venueId)/chatParticipants/$(uid);
      }

      function chatRestrictionPath(uid) {
        return /databases/$(database)/documents/leagueVenues/$(venueId)/chatRestrictions/$(uid);
      }

      function chatClubPath(clubId) {
        return /databases/$(database)/documents/clubs/$(clubId);
      }

      function chatMemberPath(clubId, memberId) {
        return /databases/$(database)/documents/clubs/$(clubId)/members/$(memberId);
      }

      function chatActiveClubMember(clubId, memberId) {
        let memberPath = chatMemberPath(clubId, memberId);
        return isSignedIn()
          && !isCameraSession()
          && clubId is string
          && memberId is string
          && clubId.size() > 0
          && memberId.size() > 0
          && exists(
            /databases/$(database)/documents/clubFieldMemberships/$(clubId)
          )
          && get(
            /databases/$(database)/documents/clubFieldMemberships/$(clubId)
          ).data.status == "active"
          && get(
            /databases/$(database)/documents/clubFieldMemberships/$(clubId)
          ).data.venueId == venueId
          && request.auth.token.get("email_verified", false) == true
          && exists(memberPath)
          && get(memberPath).data.get("status", "") == "active"
          && get(memberPath).data.get("email", "") ==
            request.auth.token.get("email", "")
          && request.auth.token.get("email", "") != ""
          && get(memberPath).data.get("uid", request.auth.uid) ==
            request.auth.uid;
      }

      function chatClubParticipant() {
        let participantPath = chatParticipantPath(request.auth.uid);
        return isSignedIn()
          && !isCameraSession()
          && exists(participantPath)
          && chatActiveClubMember(
            get(participantPath).data.clubId,
            get(participantPath).data.memberId
          );
      }

      function chatActiveStaff() {
        let staffPath = chatStaffPath(request.auth.uid);
        return isSignedIn()
          && !isCameraSession()
          && (
            chatVenue().ownerUid == request.auth.uid
            || (
              exists(staffPath)
              && get(staffPath).data.status == "active"
            )
          );
      }

      function chatAdministrator() {
        let staffPath = chatStaffPath(request.auth.uid);
        return isSignedIn()
          && !isCameraSession()
          && (
            chatVenue().ownerUid == request.auth.uid
            || (
              exists(staffPath)
              && get(staffPath).data.status == "active"
              && get(staffPath).data.isAdministrator == true
            )
          );
      }

      function chatCanRead() {
        return chatActiveStaff() || chatClubParticipant();
      }

      function chatCanPost() {
        return chatCanRead()
          && (
            !exists(chatRestrictionPath(request.auth.uid))
            || get(chatRestrictionPath(request.auth.uid)).data.muted != true
          );
      }

      function chatUsesClubIdentity() {
        return request.resource.data.get("senderRole", "") == "club_member";
      }

      function chatSelectedIdentityIsValid() {
        return chatUsesClubIdentity()
          ? chatClubParticipant()
          : chatActiveStaff();
      }

      function chatActorName() {
        let staffPath = chatStaffPath(request.auth.uid);
        let participantPath = chatParticipantPath(request.auth.uid);
        return !chatUsesClubIdentity()
          ? (
              exists(staffPath)
                ? get(staffPath).data.get("fullName", "")
                : request.auth.token.get("email", "")
            )
          : get(chatMemberPath(
              get(participantPath).data.clubId,
              get(participantPath).data.memberId
            )).data.get("fullName", "");
      }

      function chatActorRole() {
        let staffPath = chatStaffPath(request.auth.uid);
        return !chatUsesClubIdentity()
          ? (
              exists(staffPath)
                ? get(staffPath).data.get("role", "field_manager")
                : "field_manager"
            )
          : "club_member";
      }

      function chatActorClubId() {
        return !chatUsesClubIdentity()
          ? ""
          : get(chatParticipantPath(request.auth.uid)).data.clubId;
      }

      function chatActorClubName() {
        let clubId = chatActorClubId();
        return clubId == ""
          ? ""
          : get(chatClubPath(clubId)).data.get("name", clubId);
      }

      match /chatParticipants/{participantUid} {
        allow get: if isSignedIn()
          && !isCameraSession()
          && (
            participantUid == request.auth.uid
            || chatAdministrator()
          );
        allow list: if chatAdministrator();

        allow create, update: if isSignedIn()
          && !isCameraSession()
          && participantUid == request.auth.uid
          && request.resource.data.keys().hasOnly(["clubId", "memberId"])
          && request.resource.data.keys().hasAll(["clubId", "memberId"])
          && chatActiveClubMember(
            request.resource.data.clubId,
            request.resource.data.memberId
          );
        allow delete: if participantUid == request.auth.uid
          || chatAdministrator();
      }

      match /chatRestrictions/{targetUid} {
        allow get: if chatCanRead()
          && (
            targetUid == request.auth.uid
            || chatAdministrator()
          );
        allow list: if chatAdministrator();
        allow create, update: if chatAdministrator()
          && request.resource.data.keys().hasOnly([
            "uid", "muted", "reason", "updatedAt"
          ])
          && request.resource.data.keys().hasAll([
            "uid", "muted", "reason", "updatedAt"
          ])
          && request.resource.data.uid == targetUid
          && request.resource.data.muted is bool
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 300
          && request.resource.data.updatedAt == request.time;
        allow delete: if chatAdministrator();
      }

      match /chatMessages/{messageId} {
        allow read: if chatCanRead();

        allow create: if isSignedIn()
          && !isCameraSession()
          && chatSelectedIdentityIsValid()
          && (
            !exists(chatRestrictionPath(request.auth.uid))
            || get(chatRestrictionPath(request.auth.uid)).data.muted != true
          )
          && request.resource.data.keys().hasOnly([
            "text", "senderUid", "senderName", "senderRole",
            "clubId", "clubName", "createdAt", "createdAtMs",
            "replyToId", "replyToSenderName", "replyToText",
            "reactionsByUser", "attachment"
          ])
          && request.resource.data.keys().hasAll([
            "text", "senderUid", "senderName", "senderRole",
            "clubId", "clubName", "createdAt", "createdAtMs",
            "reactionsByUser"
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName == chatActorName()
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 100
          && request.resource.data.senderRole == chatActorRole()
          && request.resource.data.clubId == chatActorClubId()
          && request.resource.data.clubName == chatActorClubName()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtMs is int
          && request.resource.data.reactionsByUser == {}
          && request.resource.data.get("replyToId", "") is string
          && request.resource.data.get("replyToId", "").size() <= 120
          && request.resource.data.get("replyToSenderName", "") is string
          && request.resource.data.get("replyToSenderName", "").size() <= 100
          && request.resource.data.get("replyToText", "") is string
          && request.resource.data.get("replyToText", "").size() <= 300
          && (
            !("attachment" in request.resource.data)
            || (
              request.resource.data.attachment is map
              && request.resource.data.attachment
                .keys().hasOnly([
                  "venueId",
                  "clipId",
                  "matchId",
                  "title",
                  "mediaUrl", "kind"
                ])
              && request.resource.data.attachment
                .keys().hasAll([
                  "venueId",
                  "clipId",
                  "matchId",
                  "title",
                  "mediaUrl"
                ])
              && request.resource.data.attachment
                .venueId == venueId
              && request.resource.data.attachment
                .clipId is string
              && request.resource.data.attachment
                .clipId.size() > 0
              && request.resource.data.attachment
                .clipId.size() <= 200
              && request.resource.data.attachment
                .matchId is string
              && request.resource.data.attachment
                .matchId.size() <= 300
              && request.resource.data.attachment
                .title is string
              && request.resource.data.attachment
                .title.size() <= 160
              && request.resource.data.attachment
                .mediaUrl is string
              && request.resource.data.attachment
                .mediaUrl.size() <= 8000
              && request.resource.data.attachment
                .mediaUrl.matches("https://.*")
              && request.resource.data.attachment.get("kind", "highlight") in ["highlight", "formation"]
              && (request.resource.data.attachment.get("kind", "highlight") != "formation"
                || request.resource.data.attachment.mediaUrl.matches("https://firebasestorage.googleapis.com/v0/b/[^/]+/o/leagueVenues%2F" + venueId + "%2FchatImages%2F" + request.auth.uid + "%2F.*"))
            )
          );

        allow update: if chatCanPost()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["reactionsByUser"])
          && request.resource.data.reactionsByUser is map
          && request.resource.data.reactionsByUser
            .diff(resource.data.get("reactionsByUser", {}))
            .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.reactionsByUser
            .get(request.auth.uid, "") in [
              "", "⚽", "🔥", "🧤", "👏", "😂",
              "❤️", "👍", "👎", "😩", "🤯"
            ];

        allow delete: if chatAdministrator();
      }

      match /staffPermissions/{staffUid} {
        function creator() {
          return isSignedIn() && !isCameraSession()
            && get(
              /databases/$(database)/documents/leagueVenues/$(venueId)
            ).data.ownerUid == request.auth.uid;
        }
        allow read: if isSignedIn() && !isCameraSession()
          && (staffUid == request.auth.uid || creator());
        allow create, update: if creator()
          && request.resource.data.keys().hasOnly([
            "uid", "endMatchDay", "endSeason", "updatedByUid", "updatedAt"
          ])
          && request.resource.data.uid == staffUid
          && request.resource.data.endMatchDay is bool
          && request.resource.data.endSeason is bool
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && exists(
            /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(staffUid)
          )
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(staffUid)
          ).data.status == "active"
          && get(
            /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(staffUid)
          ).data.uid == staffUid;
        allow delete: if creator();
      }

      match /staff/{staffUid} {
        function validStaffRole() {
          return request.resource.data.role in [
            "field_manager",
            "assistant_manager",
            "field_assistant",
            "referee",
            "other_staff"
          ];
        }

        function validPermanentStaffRole() {
          return request.resource.data.role in [
            "field_manager",
            "assistant_manager",
            "field_assistant",
            "other_staff"
          ];
        }

        function registeredLegacyCreator() {
          let venue =
            getAfter(
              /databases/$(database)/documents/leagueVenues/$(venueId)
            ).data;

          return isSignedIn()
            && (
              venue.ownerUid == request.auth.uid
              || venue.createdByUid == request.auth.uid
              || (
                request.auth.token.email != null
                && (
                  venue.createdByEmail
                    == request.auth.token.email
                  || venue.ownerEmail
                    == request.auth.token.email
                  || request.auth.token.email
                    in venue.adminEmails
                )
              )
            );
        }

        function validApprovedStaffClaim() {
          let requestId =
            request.resource.data.claimedFromRequestId;
          let requestPath =
            /databases/$(database)/documents/leagueVenues/$(venueId)/staff/$(requestId);

          return exists(requestPath)
            && get(requestPath).data.status == "active"
            && get(requestPath).data.email
               == request.auth.token.email
            && get(requestPath).data.role
               == request.resource.data.role
            && get(requestPath).data.isAdministrator
               == request.resource.data.isAdministrator;
        }

        allow read: if isSignedIn();

        allow create: if isSignedIn()
                      && getAfter(/databases/$(database)/documents/leagueVenues/$(venueId)).data.get("deleted", false) != true
                      && getAfter(/databases/$(database)/documents/leagueVenues/$(venueId)).data.get("status", "") != "deleted"
                      && !isCameraSession()
                      && validStaffRole()
                      && (
                        (
                          request.resource.data.uid == staffUid
                          && request.resource.data.requestId == staffUid
                          && request.resource.data.requestedByUid
                             == request.auth.uid
                          && request.auth.token.email != null
                          && request.resource.data.email
                             == request.auth.token.email
                          && request.resource.data.status == "pending"
                          && request.resource.data.isAdministrator == false
                          && request.resource.data.isCreator == false
                        )
                        || (
                          staffUid == request.auth.uid
                          && request.resource.data.uid
                             == request.auth.uid
                          && request.resource.data.status == "active"
                          && request.resource.data.isCreator == false
                          && validApprovedStaffClaim()
                        )
                        || (
                          staffUid == request.auth.uid
                          && request.resource.data.uid
                             == request.auth.uid
                          && registeredLegacyCreator()
                          && validPermanentStaffRole()
                          && request.resource.data.status
                             == "active"
                          && request.resource.data.isAdministrator
                             == true
                          && request.resource.data.isCreator
                             == true
                        )
                      );

        allow update: if isSignedIn()
                      && !isCameraSession()
                      && (
                        (
                          staffUid == request.auth.uid
                          && registeredLegacyCreator()
                          && validPermanentStaffRole()
                          && request.resource.data.uid
                             == request.auth.uid
                          && request.resource.data.status
                             == "active"
                          && request.resource.data.isAdministrator
                             == true
                          && request.resource.data.isCreator
                             == true
                        )
                        || (
                          resource.data.status == "pending"
                          && resource.data.isCreator == false
                          && request.resource.data.uid
                             == resource.data.uid
                          && request.resource.data.isCreator == false
                          && validStaffRole()
                          && request.resource.data.status in [
                            "active",
                            "rejected"
                          ]
                          && request.resource.data.isAdministrator
                             == (
                               request.resource.data.status == "active"
                               && request.resource.data.role != "referee"
                             )
                          && activeFieldAdministrator()
                        )
                        || (
                          resource.data.status == "active"
                          && resource.data.isCreator == false
                          && resource.data.email
                             == request.auth.token.email
                          && request.resource.data.status == "claimed"
                          && request.resource.data.role
                             == resource.data.role
                          && request.resource.data.email
                             == resource.data.email
                          && request.resource.data.isAdministrator
                             == resource.data.isAdministrator
                          && request.resource.data.claimedByUid
                             == request.auth.uid
                        )
                      );

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------
    // OFFICIAL CAMERA VIDEO-HIGHLIGHT DATA
    //
    // Camera may touch only the exact club + match encoded into
    // its Firebase custom token.
    // ---------------------------------------------------------
    match /clubs/{clubId}/video_highlights/{matchId}/{document=**} {
      allow read, write:
        if cameraCanAccessMatch(clubId, matchId);
    }

    // ---------------------------------------------------------
    // PRACTICE CONTROL PLANE
    //
    // Persistent entitlement/accounting records.
    // Browser clients may read only their own entitlement.
    // All writes are server-owned.
    // ---------------------------------------------------------
    match /practiceControl/{clubId}/weeks/{weekKey}/entitlements/{userId} {
      allow read: if isCurrentUser(userId);
      allow write: if false;
    }

    // Transfer ledger is server-owned.
    match /practiceControl/{clubId}/weeks/{weekKey}/transfers/{transferId} {
      allow read, write: if false;
    }

    // Deny any other direct client access beneath practiceControl.
    match /practiceControl/{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // PRACTICE SESSION CONTROL RECORDS
    //
    // A user may inspect only their own authoritative session.
    // Creation/update/deletion is server-owned.
    // ---------------------------------------------------------
    match /practiceSessions/{sessionId} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------
    // DISPOSABLE PRACTICE FOOTBALL DATA
    //
    // A Practice sandbox is usable only by the Firebase user who
    // owns the authoritative, active, unexpired Practice session.
    //
    // All football records here are disposable. Deletes are hard
    // deletes; no soft-delete lifecycle is required.
    // ---------------------------------------------------------

    function hasActivePracticeSession(clubId, sessionId) {
      let sessionPath =
        /databases/$(database)/documents/practiceSessions/$(sessionId);

      return isSignedIn()
             && exists(sessionPath)
             && get(sessionPath).data.userId == request.auth.uid
             && get(sessionPath).data.clubId == clubId
             && get(sessionPath).data.status == "active"
             && request.time < get(sessionPath).data.expiresAt;
    }

    match /sandboxes/practice/clubs/{clubId}/sessions/{sessionId}/{document=**} {
      allow read, write:
        if hasActivePracticeSession(clubId, sessionId);
    }

    // Everything else under sandboxes remains closed.

    function hasActiveFieldPracticeSession(venueId, sessionId) {
      let sessionPath =
        /databases/$(database)/documents/practiceSessions/$(sessionId);
      let session = get(sessionPath).data;
      return isSignedIn() && !isCameraSession()
        && session.kind == "venueLeague"
        && session.environment == "practice"
        && session.venueId == venueId
        && session.userId == request.auth.uid
        && session.status == "active"
        && request.time < session.expiresAt;
    }

    match /sandboxes/practice/leagueVenues/{venueId}/sessions/{sessionId} {
      allow read, write:
        if hasActiveFieldPracticeSession(venueId, sessionId);
      match /{document=**} {
        allow read, write:
          if hasActiveFieldPracticeSession(venueId, sessionId);
      }
    }

    match /sandboxes/{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Versioned, immutable evidence of authenticated agreement.
    match /legalAcceptances/{uid}/records/{recordId} {
      allow read: if isSignedIn() && !isCameraSession()
        && request.auth.uid == uid;
      allow create: if isSignedIn() && !isCameraSession()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid", "scope", "version", "documentHash", "acceptedAt"
        ])
        && request.resource.data.keys().hasAll([
          "uid", "scope", "version", "documentHash", "acceptedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.scope in ["club", "field"]
        && request.resource.data.version == recordId
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 80
        && request.resource.data.documentHash is string
        && request.resource.data.documentHash.size() == 64
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }

    // TEMPORARY LEGACY BOOTSTRAP
    //
    // Preserve existing signed-in access for all non-Practice
    // top-level namespaces while FANM continues its migration.
    //
    // IMPORTANT:
    // Recursive wildcard matches are ORed with other matches.
    // Therefore protected Practice roots are excluded here.
    // ---------------------------------------------------------
    match /profileAccountChanges/{document=**} {
      allow read, write: if false;
    }

    // Orders, contacts, stock and payment states are accessed through the authenticated shop service.
    match /kitShopProducts/{document=**} { allow read, write: if false; }
    match /kitShopConfig/{document=**} { allow read, write: if false; }
    match /kitShopOrders/{document=**} { allow read, write: if false; }
    match /kitShopCustomers/{document=**} { allow read, write: if false; }

    // Shared pool nights are accessed only through the verified server service.
    match /poolNights/{document=**} { allow read, write: if false; }

    match /notificationPreferences/{uid}/chats/{chatKey} {
      allow read: if isSignedIn() && !isCameraSession()
        && request.auth.uid == uid;
      allow create, update: if isSignedIn() && !isCameraSession()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(["scope","groupId","muted","updatedAt"])
        && request.resource.data.keys().hasOnly(["scope","groupId","muted","updatedAt"])
        && request.resource.data.scope in ["club","field"]
        && request.resource.data.groupId is string
        && request.resource.data.groupId.matches('^[A-Za-z0-9_-]{1,150}$')
        && chatKey == request.resource.data.scope + "__" + request.resource.data.groupId
        && request.resource.data.muted is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /notificationRegistrations/{deviceId} {
      allow read: if isSignedIn() && !isCameraSession()
        && resource.data.firebaseUid == request.auth.uid;
      allow create, update: if isSignedIn() && !isCameraSession()
        && request.auth.token.get("email_verified", false) == true
        && request.resource.data.keys().hasOnly(["token","enabled","firebaseUid","deviceId","platform","rendererVersion","liveScoreVersion","updatedAt"])
        && request.resource.data.keys().hasAll(["token","enabled","firebaseUid","deviceId","platform","rendererVersion","updatedAt"])
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.deviceId == deviceId
        && deviceId.matches('^[A-Za-z0-9_-]{1,150}$')
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.token.size() < 4096
        && request.resource.data.enabled is bool
        && request.resource.data.platform in ["android","ios"]
        && request.resource.data.rendererVersion == "2"
        && request.resource.data.get("liveScoreVersion", "0") in ["0","1"]
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn() && !isCameraSession()
        && resource.data.firebaseUid == request.auth.uid;
    }
    function publicationManager(clubId, memberId) {
      let safeMemberId = memberId is string && memberId != "" ? memberId : "__none__";
      let memberPath=/databases/$(database)/documents/clubs/$(clubId)/members/$(safeMemberId);
      return clubAdministrator(clubId) || clubCaptain(clubId)
        || (memberId is string && memberId != ""
          && exists(memberPath) && ownsClubMember(clubId,memberId)
          && get(memberPath).data.get("status", "") == "active"
          && get(memberPath).data.get("role", "") in ["admin","captain"]);
    }
    match /newsStories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && !isCameraSession()
        && request.resource.data.clubId is string
        && request.resource.data.createdByUid == request.auth.uid
        && publicationManager(request.resource.data.clubId, request.resource.data.get("createdByMemberId", ""));
      allow update: if isSignedIn() && !isCameraSession()
        && request.resource.data.get("clubId", "turf-kings") == resource.data.get("clubId", "turf-kings")
        && publicationManager(resource.data.get("clubId", "turf-kings"), request.resource.data.get("lastEditorMemberId", request.resource.data.get("createdByMemberId", "")));
      allow delete: if publicationManager(resource.data.get("clubId", "turf-kings"), resource.data.get("lastEditorMemberId", resource.data.get("createdByMemberId", "")));
    }
    match /newsPolls/{pollId} {
      allow read: if true;
      allow create: if isSignedIn() && !isCameraSession()
        && publicationManager(request.resource.data.get("clubId", "turf-kings"), request.resource.data.get("createdByMemberId", ""));
      allow update: if isSignedIn() && !isCameraSession()
        && request.resource.data.get("clubId", "turf-kings") == resource.data.get("clubId", "turf-kings")
        && publicationManager(resource.data.get("clubId", "turf-kings"), request.resource.data.get("lastEditorMemberId", request.resource.data.get("createdByMemberId", "")));
      allow delete: if publicationManager(resource.data.get("clubId", "turf-kings"), resource.data.get("lastEditorMemberId", resource.data.get("createdByMemberId", "")));
    }

    match /privateFieldClubChats/{document=**} { allow read, write: if false; }

    match /privateTeamChatAccess/{document=**} { allow read, write: if false; }

    match /privateTeamChats/{document=**} { allow read, write: if false; }

    match /fieldRefereeInvites/{document=**} { allow read, write: if false; }

    // Challenge fixtures are served through authorised server operations.
    match /clubChallengeMatches/{document=**} { allow read, write: if false; }

    match /{topLevel}/{document=**} {
      allow read, write: if isSignedIn()
                         && !isCameraSession()
                         && !(topLevel in ["kitShopProducts","kitShopConfig","kitShopOrders","kitShopCustomers"])
                         && !(topLevel in ["privateFieldClubChats","privateTeamChatAccess","privateTeamChats","notificationRegistrations","notificationOutbox","notificationReceipts","notificationDeliveries","newsStories","newsPolls"])
                         && topLevel != "notificationPreferences"
                         && topLevel != "poolNights"
                         && topLevel != "profileAccountChanges"
                         && topLevel != "playerPrivacyMigrations"
                         && topLevel != "playerDebutMigrations"
                         && topLevel != "matchNumberSheets"
                         && topLevel != "practiceControl"
                         && topLevel != "practiceSessions"
                         && topLevel != "sandboxes"
                         && topLevel != "fieldRefereeInvites"
                         && topLevel != "leagueVenues"
                         && topLevel != "legalAcceptances"
                         && topLevel != "clubs"
                         && topLevel != "clubChallengeMatches"
                         && topLevel != "facebookPublicationLocks"
                         && topLevel != "facebookHighlightQueue"
                         && topLevel != "companyApplications"
                         && topLevel != "companyOrganizations"
                         && topLevel != "companyUserAccounts"
                         && topLevel != "companyFundingAccounts"
                         && topLevel != "companySponsorships"
                         && topLevel != "companyFundingAudit"
                         && topLevel != "clubStateOperators"
                         && topLevel != "clubDataAccess"
                         && topLevel != "organizationArchiveAudit"
                         && topLevel != "deletedFieldIds"
                         && topLevel != "clubFieldMemberships"
                          && topLevel != "leagueClubBookings"
                          && topLevel != "leagueSeasonSquads"
                          && topLevel != "fieldLostFoundItems"
                          && topLevel != "fieldLostFoundClaims";
    }
  }
}
