rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------
    // OFFICIAL CAMERA SESSION
    //
    // A redeemed FANM camera credential is bound to exactly one
    // Official club + match by server-issued custom-token claims.
    // ---------------------------------------------------------
    function isCameraSession() {
      return isSignedIn()
             && request.auth.token.get("cameraSession", false) == true
             && request.auth.token.get("dataScope", "") == "official";
    }

    function cameraCanAccessMatch(clubId, matchId) {
      return isCameraSession()
             && request.auth.token.get("clubId", "") == clubId
             && request.auth.token.get("matchId", "") == matchId;
    }

    // ---------------------------------------------------------
    // OFFICIAL CLUB DATA
    //
    // Preserve existing temporary bootstrap behaviour for normal
    // FANM users. Camera identities are deliberately excluded here
    // so they cannot inherit unrestricted Official-club writes.
    // ---------------------------------------------------------
    match /clubs/{clubId}/{document=**} {
      allow read: if true;
      allow write: if isSignedIn() && !isCameraSession();
    }

    // ---------------------------------------------------------
    // OFFICIAL CAMERA VIDEO-HIGHLIGHT DATA
    //
    // Camera may touch only the exact club + match encoded into
    // its Firebase custom token.
    // ---------------------------------------------------------
    match /clubs/{clubId}/video_highlights/{matchId}/{document=**} {
      allow read, write:
        if cameraCanAccessMatch(clubId, matchId);
    }

    // ---------------------------------------------------------
    // PRACTICE CONTROL PLANE
    //
    // Persistent entitlement/accounting records.
    // Browser clients may read only their own entitlement.
    // All writes are server-owned.
    // ---------------------------------------------------------
    match /practiceControl/{clubId}/weeks/{weekKey}/entitlements/{userId} {
      allow read: if isCurrentUser(userId);
      allow write: if false;
    }

    // Transfer ledger is server-owned.
    match /practiceControl/{clubId}/weeks/{weekKey}/transfers/{transferId} {
      allow read, write: if false;
    }

    // Deny any other direct client access beneath practiceControl.
    match /practiceControl/{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // PRACTICE SESSION CONTROL RECORDS
    //
    // A user may inspect only their own authoritative session.
    // Creation/update/deletion is server-owned.
    // ---------------------------------------------------------
    match /practiceSessions/{sessionId} {
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------
    // DISPOSABLE PRACTICE FOOTBALL DATA
    //
    // A Practice sandbox is usable only by the Firebase user who
    // owns the authoritative, active, unexpired Practice session.
    //
    // All football records here are disposable. Deletes are hard
    // deletes; no soft-delete lifecycle is required.
    // ---------------------------------------------------------

    function hasActivePracticeSession(clubId, sessionId) {
      let sessionPath =
        /databases/$(database)/documents/practiceSessions/$(sessionId);

      return isSignedIn()
             && exists(sessionPath)
             && get(sessionPath).data.userId == request.auth.uid
             && get(sessionPath).data.clubId == clubId
             && get(sessionPath).data.status == "active"
             && request.time < get(sessionPath).data.expiresAt;
    }

    match /sandboxes/practice/clubs/{clubId}/sessions/{sessionId}/{document=**} {
      allow read, write:
        if hasActivePracticeSession(clubId, sessionId);
    }

    // Everything else under sandboxes remains closed.
    match /sandboxes/{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // TEMPORARY LEGACY BOOTSTRAP
    //
    // Preserve existing signed-in access for all non-Practice
    // top-level namespaces while FANM continues its migration.
    //
    // IMPORTANT:
    // Recursive wildcard matches are ORed with other matches.
    // Therefore protected Practice roots are excluded here.
    // ---------------------------------------------------------
    match /{topLevel}/{document=**} {
      allow read, write: if isSignedIn()
                         && !isCameraSession()
                         && topLevel != "practiceControl"
                         && topLevel != "practiceSessions"
                         && topLevel != "sandboxes";
    }
  }
}
