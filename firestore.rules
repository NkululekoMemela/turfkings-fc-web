rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Temporary production bootstrap rule:
    // Public can read platform/club discovery data.
    match /clubs/{clubId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow signed-in users to use app data while we migrate.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
